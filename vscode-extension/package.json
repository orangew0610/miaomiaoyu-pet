{
  "name": "debugpet-vscode",
  "displayName": "DebugPet 2.0",
  "description": "Send local VSCode diagnostics to DebugPet without uploading source code.",
  "version": "0.2.0",
  "publisher": "debugpet-local",
  "repository": {
    "type": "git",
    "url": "https://github.com/orangew0610/miaomiaoyu-pet.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "configuration": {
      "title": "DebugPet",
      "properties": {
        "debugpet.minimumSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "description": "Least severe diagnostic sent to the local DebugPet process."
        },
        "debugpet.shareCode": {
          "type": "boolean",
          "default": false,
          "description": "Include source snippets in local IPC events. DebugPet still requires its own upload authorization before external AI use."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.6.0"
  }
}
